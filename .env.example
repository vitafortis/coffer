# For `pnpm dev` / `pnpm start` outside Docker. In Docker, set these in compose.yaml.

# Where the database and key file live.
COFFER_DATA_DIR=./data

# Optional master secret. If unset, a random 256-bit key is written to $COFFER_DATA_DIR/secret.key.
# Back it up separately from the database: without it the secrets can't be read.
# COFFER_SECRET_KEY=

# Create the first account on start instead of using the setup screen.
# COFFER_ADMIN_EMAIL=you@example.com
# COFFER_ADMIN_PASSWORD=
# COFFER_ADMIN_NAME=
