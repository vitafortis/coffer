{
	"manifest_version": 3,
	"name": "Coffer",
	"version": "0.1.0",
	"description": "Search and copy secrets from your Coffer, and fill password fields with new passwords.",
	"icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
	"action": {
		"default_popup": "popup.html",
		"default_title": "Coffer",
		"default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
	},
	"background": { "service_worker": "background.js", "type": "module" },
	"permissions": ["storage", "contextMenus", "activeTab", "scripting", "offscreen", "clipboardWrite", "clipboardRead", "alarms"],
	"optional_host_permissions": ["https://*/*", "http://*/*"],
	"commands": {
		"_execute_action": { "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" }, "description": "Open Coffer" }
	},
	"minimum_chrome_version": "116"
}
